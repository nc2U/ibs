### FOR DJANGO APP ----------------------------------------------------------------------------------
SECRET_KEY=                   # required, Set random characters of at least 50 characters.
DEBUG=                        # default=False
ALLOWED_HOSTS=                # default=*, set like this -> host1,host2,host3...
CSRF_TRUSTED_ORIGINS=         # default='https://***.*****.com'

DATABASE_USER=                # default=db-user
DATABASE_PASS=                # default=db-secret

DOMAIN_HOST=                  # default=https://***.*****.com/
DOMAIN_NAME=                  # default=ibs.dyibs.com
SESSION_COOKIE_DOMAIN=        # ".*****.com" // 서브도메인 간 이동 시 세션 유지
CSRF_COOKIE_DOMAIN=           # ".*****.com" // 서브도메인 간 이동 시 CSRF 유지

EMAIL_HOST=                   # required, ex: mail.*****.com
EMAIL_PORT=                   # default=587
EMAIL_HOST_USER=              # required, ex: 'my-account'
EMAIL_HOST_PASSWORD=          # required, ex: 'my-password'
DEFAULT_FROM_EMAIL=           # required, ex: '관리자 <info@*****.com>'
SLACK_NOTIFICATIONS_ENABLED=  # default=True, IBS work notifications

